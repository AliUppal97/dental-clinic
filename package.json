{
  "name": "dental-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-theme.mjs && NEXT_DIST_DIR=.next-dev next dev -p 3001",
    "build": "node scripts/sync-theme.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "verify": "node scripts/sync-theme.mjs && tsc --noEmit && next lint",
    "clean": "rm -rf .next .next-dev",
    "dev:reset": "npm run clean && npm run dev",
    "sync-theme": "node scripts/sync-theme.mjs"
  },
  "dependencies": {
